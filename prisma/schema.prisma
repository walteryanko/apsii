generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Paciente {
  id           Int      @id @default(autoincrement())
  nome         String
  cpf          String   @unique
  telefone     String
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")
  consultas    Consulta[]

  @@map("pacientes")
}

model Medico {
  id            Int      @id @default(autoincrement())
  nome          String
  crm           String   @unique
  especialidade String
  criadoEm      DateTime @default(now()) @map("criado_em")
  atualizadoEm  DateTime @updatedAt @map("atualizado_em")
  consultas     Consulta[]

  @@map("medicos")
}

model Consulta {
  id         Int      @id @default(autoincrement())
  data       DateTime
  turno      String
  medicoId   Int      @map("medico_id")
  pacienteId Int      @map("paciente_id")
  medico     Medico   @relation(fields: [medicoId], references: [id], onDelete: Restrict)
  paciente   Paciente @relation(fields: [pacienteId], references: [id], onDelete: Restrict)

  @@index([medicoId])
  @@index([pacienteId])
  @@map("consultas")
}
